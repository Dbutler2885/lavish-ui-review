{
  "name": "lavish-ui-review",
  "version": "0.1.36",
  "packageManager": "pnpm@11.1.1",
  "description": "Review UI mockups in the browser. Draw on them, annotate text and DOM elements, and send it all back to your coding agent.",
  "type": "module",
  "bin": {
    "lavish-axi": "dist/cli.mjs",
    "lavish-ui-review": "dist/ui-review.mjs"
  },
  "files": [
    "dist",
    "skills/lavish",
    "skills/lavish-ui-review",
    "lavish-editor-marketing/renders/lavish-editor-marketing.gif",
    "LICENSE",
    "workflow",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:skill": "node scripts/build-skill.js",
    "check": "npm run build && npm run lint && npm run format:check && npm run typecheck && npm test && node scripts/build-skill.js --check",
    "start": "node dist/cli.mjs",
    "lint": "eslint bin src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "workflow:test": "node --test workflow/tests/*.test.mjs",
    "workflow:status": "bash workflow/bin/fe-status.sh",
    "workflow:render": "bash workflow/bin/fe-render.sh",
    "workflow:review": "bash workflow/bin/fe-review.sh"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.2.4",
    "axi-sdk-js": "^0.1.8",
    "chokidar": "^4.0.3",
    "daisyui": "^5.5.19",
    "express": "^5.2.1",
    "konva": "^10.3.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "html",
    "review",
    "collaboration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dbutler2885/lavish-ui-review.git"
  },
  "bugs": {
    "url": "https://github.com/Dbutler2885/lavish-ui-review/issues"
  },
  "homepage": "https://github.com/Dbutler2885/lavish-ui-review#readme",
  "publishConfig": {
    "access": "public"
  }
}
